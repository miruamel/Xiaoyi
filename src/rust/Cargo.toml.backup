[package]
name = "xiaoyi"
version = "0.1.0"
edition = "2024"
description = "Xiaoyi AI Agent Framework - Core Runtime"
authors = ["Miruamel"]
license = "MIT"
repository = "https://github.com/miruamel/Xiaoyi"
readme = "../../README.md"

[lib]
name = "xiaoyi"
crate-type = ["cdylib", "rlib"]

[features]
default = ["python", "nodejs"]
python = ["pyo3"]
nodejs = ["napi", "napi-derive"]
napi-derive = ["dep:napi-derive"]

[dependencies]
# Core
thiserror = "1.0"
anyhow = "1.0"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
tokio = { version = "1.38", features = ["full"] }
tracing = "0.1"
tracing-subscriber = "0.3"
async-trait = "0.1"
futures = "0.3"
clap = { version = "4.5", features = ["derive"] }

# Config
config = "0.13"
toml = "0.8"
yaml-rust2 = "0.8"
serde_yaml = "0.9"
base64 = "0.22"

# Crypto
aes-gcm = "0.10"
pbkdf2 = "0.12"
rand = "0.8"
zeroize = "1.6"
sha2 = "0.10"

# Graph
petgraph = "0.6"
indexmap = "2.0"

# LLM
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls", "rustls-tls-webpki-roots"] }
async-openai = "0.20"

# Memory
parking_lot = "0.12"
lru = "0.10"

# Python bindings (PyO3)
pyo3 = { version = "0.29", features = ["extension-module", "abi3-py38"], optional = true }
# Node.js bindings (napi-rs)
napi = { version = "2", optional = true }
napi-derive = { version = "2", optional = true }

[dev-dependencies]
tokio-test = "0.4"
pretty_assertions = "1.4"

# Nightly features
[profile.release]
lto = "fat"
codegen-units = 1
strip = true
panic = "abort"

[profile.dev]
debug = 2
overflow-checks = true
