{
  "name": "@xiaoyi/typescript",
  "version": "0.1.0",
  "description": "Xiaoyi AI Agent Framework - TypeScript Implementation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "docs": "typedoc --out docs src",
